# Cloudflare Pages: eigene Antwortköpfe für die statische Auslieferung.
# Alles andere wird mit den Standard-Regeln von Cloudflare Pages ausgeliefert.

/api/health
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store

/images/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
